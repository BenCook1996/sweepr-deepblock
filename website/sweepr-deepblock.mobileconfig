<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>PayloadContent</key>
  <array>
    <dict>
      <key>FullScreen</key>
      <true/>
      <key>IgnoreManifestScope</key>
      <true/>
      <key>IsRemovable</key>
      <true/>
      <key>Label</key>
      <string>SWEEPR Deepblock</string>
      <key>PayloadDescription</key>
      <string>Installs the SWEEPR Deepblock app onto your iPhone or iPad Home Screen.</string>
      <key>PayloadDisplayName</key>
      <string>SWEEPR Deepblock iOS App</string>
      <key>PayloadIdentifier</key>
      <string>com.sweeprdeepblock.ios.webclip</string>
      <key>PayloadType</key>
      <string>com.apple.webClip.managed</string>
      <key>PayloadUUID</key>
      <string>5A93B2C1-84E1-4F1D-9A7B-3E20D45C8199</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>Precomposed</key>
      <true/>
      <key>URL</key>
      <string>https://sweeprdeepblock.com/ios-app</string>
    </dict>
    <dict>
      <key>DNSSettings</key>
      <dict>
        <key>DNSProtocol</key>
        <string>HTTPS</string>
        <key>ServerURL</key>
        <string>https://dns.adguard-dns.com/dns-query</string>
      </dict>
      <key>PayloadDescription</key>
      <string>Configures SWEEPR Deepblock Encrypted DNS-over-HTTPS (DoH) to block ads, trackers, and phishing domains across Safari and all apps.</string>
      <key>PayloadDisplayName</key>
      <string>SWEEPR Deepblock Encrypted Ad &amp; Tracker Shield</string>
      <key>PayloadIdentifier</key>
      <string>com.sweeprdeepblock.dns.doh</string>
      <key>PayloadType</key>
      <string>com.apple.dnsSettings.managed</string>
      <key>PayloadUUID</key>
      <string>6A93B2C1-84E1-4F1D-9A7B-3E20D45C8190</string>
      <key>PayloadVersion</key>
      <integer>1</integer>
      <key>ProhibitDisablement</key>
      <false/>
    </dict>
  </array>
  <key>PayloadDescription</key>
  <string>1-Tap SWEEPR Deepblock Protection &amp; App Installer for iPhone, iPad, and Mac. Installs the SWEEPR Deepblock app and blocks ad networks, tracking pixels, and fake e-commerce scam domains system-wide via Encrypted DNS-over-HTTPS.</string>
  <key>PayloadDisplayName</key>
  <string>SWEEPR Deepblock (iOS, iPadOS &amp; macOS)</string>
  <key>PayloadIdentifier</key>
  <string>com.sweeprdeepblock.profile</string>
  <key>PayloadOrganization</key>
  <string>SWEEPR Technologies</string>
  <key>PayloadRemovalDisallowed</key>
  <false/>
  <key>PayloadType</key>
  <string>Configuration</string>
  <key>PayloadUUID</key>
  <string>9F81C4D2-31A0-48B5-8C62-7D14E9A02026</string>
