{
  "manifest_version": 3,
  "name": "SWEEPR DeepBlock: Ad Blocker & Cookie Auto-Reject",
  "short_name": "SWEEPR DeepBlock",
  "version": "1.2.7",
  "description": "Blocks video & banner ads, auto-rejects GDPR cookie popups, flags scam stores, and frees browser RAM. No browsing history logged.",
  "homepage_url": "https://sweeprdeepblock.com",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "alarms",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "SWEEPR DeepBlock Dashboard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Open SWEEPR DeepBlock Dashboard"
    },
    "toggle-site-protection": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Pause or Resume SWEEPR DeepBlock on Current Site"
    },
    "snooze-inactive-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+Z",
        "mac": "Alt+Shift+Z"
      },
      "description": "Snooze Inactive Background Tabs & Free RAM"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@sweeprdeepblock.com",
      "strict_min_version": "128.0"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_and_trackers",
        "enabled": false,
        "path": "rules/static_ads_and_trackers.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/deepblock-stealth-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/deepblock-content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "rules/empty.js",
        "rules/empty.txt"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
