{
  "manifest_version": 3,
  "name": "SWEEPR Deepblock — Block Ads, Cookie Pop-Ups & Fake Shops",
  "short_name": "SWEEPR Deepblock",
  "version": "1.1.0",
  "description": "Block YouTube & banner ads, automatically say No to cookie pop-ups, hide junk search results, and spot fake online shops.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "alarms",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "welcome.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-site-protection": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Pause or resume SWEEPR Deepblock on the current website"
    },
    "snooze-inactive-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+Z",
        "mac": "MacCtrl+Shift+Z"
      },
      "description": "Snooze unused background tabs to free memory"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SWEEPR Deepblock — Ad, Pop-Up & Fake Shop Protection",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_and_trackers",
        "enabled": true,
        "path": "rules/static_ads_and_trackers.json"
      },
      {
        "id": "cryptominers_and_heavy_scripts",
        "enabled": true,
        "path": "rules/cryptominers.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/deepstealth-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/deepblock-content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "extension@sweeprdeepblock.com",
      "strict_min_version": "109.0"
    }
  }
}
